#!/usr/bin/env bash
#
# gorilator — thin wrapper around the native Node CLI (packages/cli, published
# as the `gorilator` npm package). It guarantees a Node runtime (the one thing
# `npx` can't bootstrap on a bare box), builds the in-repo CLI if needed, then
# hands every argument to that same Node CLI. So all three of these run IDENTICAL
# code:
#
#   bash cli/gorilator <cmd>      (this wrapper, from a checkout)
#   npx gorilator <cmd>           (the published package)
#   gorilator <cmd>               (the globally-installed command)
#
# Usage:  gorilator install | setup | start | stop | restart | status | info |
#                   logs | update | tunnel <login|status|restart> | uninstall
#
set -euo pipefail

# --- Resolve the project root through the (possibly symlinked) script path.
#     Resolved portably because macOS's readlink lacks GNU's -f. ---
SELF="${BASH_SOURCE[0]}"
while [ -h "$SELF" ]; do
  _dir="$(cd -P "$(dirname "$SELF")" && pwd)"
  SELF="$(readlink "$SELF")"
  case "$SELF" in /*) ;; *) SELF="$_dir/$SELF" ;; esac
done
SELF="$(cd -P "$(dirname "$SELF")" && pwd)/$(basename "$SELF")"
PROJECT_DIR="$(cd "$(dirname "$SELF")/.." && pwd)"
CLI_DIR="$PROJECT_DIR/packages/cli"
CLI_ENTRY="$CLI_DIR/dist/index.js"

# --- Pretty logging (plain when not a TTY) ---
if [ -t 1 ]; then
  BLU=$'\033[34m'; GRN=$'\033[32m'; YLW=$'\033[33m'; RED=$'\033[31m'; CLR=$'\033[0m'
else
  BLU=""; GRN=""; YLW=""; RED=""; CLR=""
fi
info() { printf '%s %s\n' "${BLU}==>${CLR}" "$*"; }
ok()   { printf '%s %s\n' "${GRN}✓${CLR}" "$*"; }
warn() { printf '%s %s\n' "${YLW}!${CLR}" "$*" >&2; }
die()  { printf '%s %s\n' "${RED}✗${CLR}" "$*" >&2; exit 1; }

SUDO=""
[ "$(id -u)" -ne 0 ] && command -v sudo >/dev/null 2>&1 && SUDO="sudo"

run_privileged() {
  if [ "$(id -u)" -eq 0 ]; then
    "$@"
  elif [ -n "$SUDO" ]; then
    $SUDO "$@"
  else
    die "Need root privileges to run: $*. Re-run with sudo or as root."
  fi
}

run_privileged_stdin_env() {
  if [ "$(id -u)" -eq 0 ]; then
    env "$@"
  elif [ -n "$SUDO" ]; then
    $SUDO -E "$@"
  else
    die "Need root privileges to run: $*. Re-run with sudo or as root."
  fi
}

install_packages() {
  if command -v apt-get >/dev/null 2>&1; then
    run_privileged apt-get update -y
    run_privileged env DEBIAN_FRONTEND=noninteractive apt-get install -y "$@"
  elif command -v dnf >/dev/null 2>&1; then
    run_privileged dnf install -y "$@"
  elif command -v yum >/dev/null 2>&1; then
    run_privileged yum install -y "$@"
  elif command -v zypper >/dev/null 2>&1; then
    run_privileged zypper --non-interactive install "$@"
  elif command -v apk >/dev/null 2>&1; then
    run_privileged apk add --no-cache "$@"
  elif command -v pacman >/dev/null 2>&1; then
    run_privileged pacman -Sy --noconfirm --needed "$@"
  elif [ "$(uname -s)" = "Darwin" ] && command -v brew >/dev/null 2>&1; then
    brew install "$@"
  else
    die "No supported package manager found. Install these manually and re-run: $*"
  fi
}

ensure_command() {
  local cmd="$1"
  shift
  if command -v "$cmd" >/dev/null 2>&1; then
    return 0
  fi
  info "Installing $cmd…"
  install_packages "$@"
  command -v "$cmd" >/dev/null 2>&1 || die "$cmd was not found after installation."
}

# --- Node ≥ 20.6 is required (the daemon runs the server with `node --import
#     tsx`, and parseArgs/module.register need 20.6+). ---
node_ok() {
  command -v node >/dev/null 2>&1 || return 1
  local v maj rest min
  v="$(node -v 2>/dev/null)"; v="${v#v}"
  maj="${v%%.*}"; rest="${v#*.}"; min="${rest%%.*}"
  [ "${maj:-0}" -gt 20 ] 2>/dev/null && return 0
  [ "${maj:-0}" -eq 20 ] 2>/dev/null && [ "${min:-0}" -ge 6 ] 2>/dev/null && return 0
  return 1
}

prefer_brew_node() {
  command -v brew >/dev/null 2>&1 || return 1
  local formula prefix
  for formula in node@20 node; do
    prefix="$(brew --prefix "$formula" 2>/dev/null || true)"
    if [ -n "$prefix" ] && [ -x "$prefix/bin/node" ]; then
      export PATH="$prefix/bin:$PATH"
      node_ok && return 0
    fi
  done
  return 1
}

ensure_node() {
  local os; os="$(uname -s)"
  if node_ok; then return 0; fi  # silent when Node is already fine — stay transparent
  if [ "$os" = "Darwin" ]; then
    prefer_brew_node && return 0
  fi
  info "Installing Node.js 20 (the daemon needs Node ≥ 20.6)…"
  if [ "$os" = "Linux" ] && command -v apt-get >/dev/null 2>&1; then
    ensure_command curl curl ca-certificates
    curl -fsSL https://deb.nodesource.com/setup_20.x | run_privileged_stdin_env bash -
    run_privileged apt-get install -y nodejs
  elif [ "$os" = "Linux" ] && { command -v dnf >/dev/null 2>&1 || command -v yum >/dev/null 2>&1; }; then
    ensure_command curl curl ca-certificates
    curl -fsSL https://rpm.nodesource.com/setup_20.x | run_privileged_stdin_env bash -
    install_packages nodejs
  elif [ "$os" = "Linux" ]; then
    warn "NodeSource does not support this package manager directly; trying distro packages."
    install_packages nodejs npm
  elif [ "$os" = "Darwin" ] && command -v brew >/dev/null 2>&1; then
    if brew install node@20; then
      brew link --overwrite --force node@20 2>/dev/null || true
    else
      brew install node
    fi
    prefer_brew_node || true
  else
    die "Node ≥ 20.6 is required and can't be auto-installed here. Install Node 20+ and re-run."
  fi
  node_ok || die "Node install didn't produce Node ≥ 20.6. Install it manually and re-run."
  ok "Node $(node -v)"
}

# --- Build the in-repo CLI (tsc) so this checkout runs its own code. Isolated
#     `npm install` in packages/cli (just typescript + @types/node); the game's
#     own deps are installed later by `gorilator install`. ---
build_local_cli() {
  [ -f "$CLI_DIR/package.json" ] || return 1
  info "Building the gorilator CLI…"
  ( cd "$CLI_DIR" && npm install --no-audit --no-fund --silent && npm run build --silent ) \
    || { warn "Local CLI build failed."; return 1; }
}

is_version_request() {
  [ "$#" -eq 1 ] || return 1
  case "$1" in
    --version|-v|version) return 0 ;;
    *) return 1 ;;
  esac
}

print_cli_version() {
  local version
  version="$(
    node -e '
      const { readFileSync } = require("node:fs");
      const pkg = JSON.parse(readFileSync(process.argv[1], "utf8"));
      if (pkg.name !== "gorilator" || typeof pkg.version !== "string" || pkg.version.trim() === "") {
        process.exit(1);
      }
      process.stdout.write(pkg.version);
    ' "$CLI_DIR/package.json" 2>/dev/null || true
  )"
  printf 'gorilator %s\n' "${version:-0.0.0}"
}

main() {
  ensure_node
  if is_version_request "$@"; then
    print_cli_version
    exit 0
  fi
  if [ ! -f "$CLI_ENTRY" ]; then
    build_local_cli || true
  fi
  if [ -f "$CLI_ENTRY" ]; then
    exec node "$CLI_ENTRY" "$@"
  fi
  # No local build available — fall back to the published package.
  warn "Using the published gorilator package (npx) — local build unavailable."
  exec npx -y gorilator "$@"
}

main "$@"
