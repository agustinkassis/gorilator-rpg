{
  "name": "rpg-online",
  "version": "1.15.1",
  "private": true,
  "description": "Multiplayer isometric low-poly RPG demo — Babylon.js + Colyseus",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/dev.mjs",
    "bootstrap": "node scripts/setup.mjs",
    "wt": "node scripts/wt.mjs",
    "wt:launch": "node scripts/wt-launch.mjs",
    "wt:launch:all": "node scripts/wt-launch.mjs --all",
    "dev:server": "pnpm build:shared && pnpm --filter @rpg/server dev",
    "dev:client": "pnpm build:shared && pnpm --filter @rpg/client dev",
    "build": "node scripts/build-plugins.mjs && turbo run build",
    "build:plugins": "node scripts/build-plugins.mjs",
    "build:shared": "turbo run build --filter=@rpg/shared",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint && biome lint scripts plugins tests playwright.config.ts",
    "format": "biome format --write .",
    "test": "turbo run test",
    "e2e": "pnpm build:shared && pnpm build:plugins && playwright test",
    "e2e:game": "pnpm build:shared && pnpm build:plugins && playwright test --project=game",
    "bench": "node scripts/bench.mjs",
    "bench:update": "node scripts/bench.mjs --update-baseline",
    "perf": "node scripts/perf-analyze.mjs",
    "bump": "node scripts/bump.mjs",
    "version:check": "node scripts/check-versions.mjs",
    "deploy": "node packages/cli/gorilator.cjs install",
    "gorilator": "node packages/cli/gorilator.cjs"
  },
  "dependencies": {
    "@rpg/shared": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@playwright/test": "^1.60.0",
    "@vitest/coverage-v8": "^4.1.8",
    "esbuild": "^0.28.0",
    "turbo": "^2.9.17",
    "typescript": "^5.7.3",
    "vitest": "^4.1.8"
  },
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msgpackr-extract"
    ],
    "overrides": {
      "rollup": "npm:@rollup/wasm-node@4.60.4"
    }
  }
}
