{
  "name": "rpg-online",
  "version": "0.1.0",
  "private": true,
  "description": "Multiplayer isometric low-poly RPG demo — Babylon.js + Colyseus",
  "scripts": {
    "dev": "pnpm --filter @rpg/shared build && concurrently -n shared,server,client -c gray,blue,green \"pnpm --filter @rpg/shared dev\" \"pnpm --filter @rpg/server dev\" \"pnpm --filter @rpg/client dev\"",
    "dev:server": "pnpm --filter @rpg/shared build && pnpm --filter @rpg/server dev",
    "dev:client": "pnpm --filter @rpg/shared build && pnpm --filter @rpg/client dev",
    "build:shared": "pnpm --filter @rpg/shared build",
    "build": "pnpm --filter @rpg/shared build && pnpm --filter @rpg/client build",
    "deploy": "bash cli/gorilator install",
    "gorilator": "bash cli/gorilator"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "msgpackr-extract"]
  }
}
