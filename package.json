{
  "name": "rpg-online",
  "version": "0.1.3",
  "private": true,
  "description": "Multiplayer isometric low-poly RPG demo — Babylon.js + Colyseus",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "pnpm --filter @rpg/shared build && pnpm --filter @rpg/server dev",
    "dev:client": "pnpm --filter @rpg/shared build && pnpm --filter @rpg/client dev",
    "dev:landing": "pnpm --filter @gorilator/landing dev",
    "landing": "pnpm --filter @gorilator/landing dev",
    "build:shared": "pnpm --filter @rpg/shared build",
    "build": "pnpm --filter @rpg/shared build && pnpm --filter @rpg/client build && pnpm --filter @gorilator/landing build",
    "build:landing": "pnpm --filter @gorilator/landing build",
    "deploy": "bash cli/gorilator install",
    "gorilator": "bash cli/gorilator"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "msgpackr-extract"],
    "overrides": {
      "rollup": "npm:@rollup/wasm-node@4.60.4"
    }
  }
}
