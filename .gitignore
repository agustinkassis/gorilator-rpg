node_modules/
dist/
.DS_Store
*.log
.env
.env.*
!.env.example
.vite/
packages/*/dist/

# Realm-tracker lifetime stats (runtime state; mirrored to the Nostr event)
.server-realms.json

# Performance logs + benchmark results (client JSONL via the F3 overlay, server
# JSONL when PERF_LOG=1). Local profiling artefacts; analyze with scripts/perf-analyze.mjs
perf-logs/

# Legacy local Nostr secret file; the server now uses NOSTR_NSEC only, but keep
# old secrets out of git.
.nostr-identity

# User-imported 3D models (large binaries; imported locally via Dev Mode)
packages/client/public/models/*.glb
packages/client/public/models/characters/

# Local agent/tooling state (not for the public repo)
.claude/
