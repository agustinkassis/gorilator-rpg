node_modules/
dist/
.DS_Store
*.log
.env
.env.*
!.env.example
.vite/
packages/*/dist/

# Realm-tracker lifetime stats (runtime state; mirrored to the Nostr event)
.server-realms.json

# Performance logs + benchmark results (client JSONL via the F3 overlay, server
# JSONL when PERF_LOG=1). Local profiling artefacts; analyze with scripts/perf-analyze.mjs
perf-logs/

# Legacy local Nostr secret file; the server now uses NOSTR_NSEC only, but keep
# old secrets out of git.
.nostr-identity

# User-imported 3D models (large binaries; imported locally via Dev Mode)
packages/client/public/models/*.glb
!packages/client/public/models/goblin_house.glb
packages/client/public/models/characters/

# Shared agent/tooling config is committed so new developers get the same
# startup flow. Local runtime state and machine-specific permissions stay out.
.claude/worktrees/
.claude/settings.local.json
.claude/**/*.local.json
.codex/worktrees/
.codex/settings.local.json
.codex/*.local.toml
.codex/*.local.json

# Local Gorilator CLI project settings, process state, and logs
.gorilator/

# Local screenshots, bot runs, and generated verification artifacts
test-artifacts/
