# Gorilator deploy config. The `gorilator` CLI generates a real .env from this
# during `gorilator install`; copy it manually for a standalone docker compose run:
#   cp .env.example .env   &&   docker compose up -d --build

# Public WebSocket URL of the SERVER subdomain, baked into the client bundle.
# Must be the Cloudflare server hostname over wss (port 443, NOT :2567).
# Leave EMPTY for a local/manual run — the client then dials ws://<host>:2567.
VITE_SERVER_URL=wss://api.example.com

# The server's own Nostr secret key (an `nsec1…`). The server signs each Nostr
# player's progress save (kind 30078) to the relays with it, so it must stay
# STABLE across restarts/redeploys or saved progress becomes unrecoverable.
# `gorilator install` generates one automatically. For a manual run you can
# leave it empty — the server then mints an ephemeral key at boot and prints it
# to its logs (copy it back here to persist progress). Generate one yourself:
#   node cli/gen-nsec.mjs
NOSTR_NSEC=

# Colyseus /colyseus monitor HTTP Basic auth. When both are set the monitor is
# password-protected; leave both empty to expose it openly (local dev only).
MONITOR_USER=admin
MONITOR_PASS=change-me

# Public hostnames the CLI tunnels (informational; used by `gorilator status`).
CLIENT_HOSTNAME=play.example.com
SERVER_HOSTNAME=api.example.com

# Realm tracking + discovery (see REALMS.md). The server publishes an updatable
# Nostr event (kind 30078, d-tag "gorilator-server", signed by NOSTR_NSEC) and
# exposes /api/status + /api/realm so external apps can list servers and the realm
# being played. NOSTR_NSEC must be stable for a stable server identity.
SERVER_NAME=Gorilator Server          # human-readable server name in the event/API
PLAY_URL=                             # public URL players join at (defaults to https://CLIENT_HOSTNAME)
SERVER_STATS_FILE=                    # where lifetime totals persist (default ./.server-realms.json)
